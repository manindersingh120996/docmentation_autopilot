# Environment Configuration Template
# Copy this to .env.local and fill in your actual values
# DO NOT commit .env.local to Git!

# ============================================================================
# Application Environment
# ============================================================================
APP_ENV=local

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# OpenRouter (provides access to multiple LLM providers)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: Direct provider keys (if not using OpenRouter)
# ANTHROPIC_API_KEY=your_anthropic_key
# OPENAI_API_KEY=your_openai_key

# ============================================================================
# GitHub Integration
# ============================================================================

# GitHub Personal Access Token (for API access)
# Generate at: https://github.com/settings/tokens
# Needs scopes: repo, read:org
GITHUB_API_TOKEN=ghp_your_github_token_here

# GitHub Webhook Secret (for validating webhook signatures)
# Generate a random string for this
GITHUB_WEBHOOK_SECRET=your_random_secret_here

# ============================================================================
# Local Development Services (Docker)
# These match docker-compose.yml defaults - usually don't need to change
# ============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=docautopilot

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=devpassword

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================================================
# Observability (Optional)
# ============================================================================

# LangSmith (for LLM tracing and debugging)
# Sign up at: https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=documentation-autopilot-local

# ============================================================================
# Slack Integration (Optional)
# ============================================================================

# Slack Webhook URL for notifications
# Create at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

